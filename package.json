{
  "name": "notie",
  "description": "notie - a clean and simple notification, input, and selection suite for javascript, with no dependencies",
  "author": "Jared Reich",
  "version": "4.3.1",
  "main": "./dist/notie.min.js",
  "module": "./dist/notie.esm.js",
  "types": "./dist/notie.d.ts",
  "style": "./dist/notie.min.css",
  "sass": "./src/notie.scss",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/notie.d.ts",
      "import": "./dist/notie.esm.js",
      "require": "./dist/notie.min.js",
      "default": "./dist/notie.min.js"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaredreich/notie.git"
  },
  "keywords": [
    "javascript",
    "notification",
    "alert",
    "prompt",
    "confirm",
    "growl",
    "toast",
    "message"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jaredreich/notie/issues"
  },
  "homepage": "https://jaredreich.com/notie",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "esbuild": "0.25.12",
    "sass": "1.83.4"
  }
}
